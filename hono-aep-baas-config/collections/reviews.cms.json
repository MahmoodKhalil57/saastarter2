{
  "$schema": "https://mizan-gpp.the-montiapple.workers.dev/v1/schemas/collection-config.json",
  "definition": {
    "singular": "review",
    "plural": "reviews",
    "fields": [
      {
        "name": "product",
        "type": "string",
        "required": true
      },
      {
        "name": "rating",
        "type": "number",
        "integer": true,
        "required": true
      },
      {
        "name": "title",
        "type": "string"
      },
      {
        "name": "body",
        "type": "string"
      },
      {
        "name": "author_name",
        "type": "string"
      },
      {
        "name": "created_by",
        "type": "string"
      }
    ],
    "policy_create": "authenticated",
    "policy_update": {
      "owner": {
        "field": "created_by"
      }
    },
    "policy_delete": {
      "owner": {
        "field": "created_by"
      }
    },
    "policy_list": "public",
    "policy_get": "public",
    "owner": "created_by"
  },
  "created_by": ""
}
